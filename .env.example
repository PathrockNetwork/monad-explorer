# ── Monad RPC ───────────────────────────────────────────────────────────────
# Comma-separated, in priority order. The public gateways allow ~50 req/s per
# IP (batch items count individually); the clients stay well under that.
RPC_URLS=https://rpc.monad.xyz,https://rpc3.monad.xyz,https://rpc2.monad.xyz
# Expected chain id; the indexer refuses to start against anything else.
# CHAIN_ID=143
# Request budget per second: indexer / API (separate processes, separate buckets).
# RPC_RPS=25
# API_RPC_RPS=15
# WebSocket endpoints for the MonadBFT stage stream (monadNewHeads).
# WS_URLS=wss://rpc.monad.xyz,wss://rpc3.monad.xyz

# ── Postgres ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://monad:CHANGE_ME@localhost:5432/monad_explorer

# ── Indexer ─────────────────────────────────────────────────────────────────
# Blocks to backfill behind head (~0.4s each: 30,000 ≈ 3.3h of chain), or "all"
# to walk back to genesis (only with RETAIN_HOURS=0 and a private RPC).
# BACKFILL_DEPTH=30000
# Rolling window kept in Postgres; older data is read from the archive RPC.
# 0 keeps everything (full-history mode). Staking events are always kept.
# RETAIN_HOURS=72
# Blocks fetched in parallel while catching up (each costs 2 requests).
# FETCH_CONCURRENCY=4

# Tracing: call/prestate traces (internal transfers, parallelism graph) for
# every Nth block, and eth_estimateGas replay of each of its transactions
# (gas overpayment). Costs 4 requests + 1 per transaction per traced block.
# TRACE_EVERY=10        # 0 disables
# ESTIMATE_GAS=1        # 0 skips the gas replay
# ESTIMATE_CONCURRENCY=4

# Staking history: crawl staking precompile logs backwards from the indexed
# window. The public RPC caps eth_getLogs at 100 blocks per call.
# STAKING_HISTORY=1
# STAKING_LOGS_RANGE=100
# STAKING_HISTORY_RPS=2
# STAKING_HISTORY_FLOOR=0

# MonadBFT stage stream (Proposed/Voted/Finalized/Verified per block).
# PIPELINE=1

# ── Private RPC profile ─────────────────────────────────────────────────────
# With your own node (or a paid endpoint without the public limits), point
# RPC_URLS/WS_URLS at it and raise the budgets:
#   RPC_URLS=https://your-node:8080          WS_URLS=wss://your-node:8081
#   RPC_RPS=400  API_RPC_RPS=100  FETCH_CONCURRENCY=16
#   TRACE_EVERY=1  ESTIMATE_CONCURRENCY=16
#   STAKING_LOGS_RANGE=10000  STAKING_HISTORY_RPS=20
#   RETAIN_HOURS=0  BACKFILL_DEPTH=all      # full history (plan disk accordingly)

# ── API ─────────────────────────────────────────────────────────────────────
API_PORT=3001
# Loopback by default; the public facade is Caddy (deploy/Caddyfile.monad).
# API_HOST=127.0.0.1
# Concurrent /api/v1/stream (server-sent events) connections.
# MAX_STREAM_CLIENTS=200
